@model FirstWebMVC.Models.Student

<h2>Thêm sinh viên</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Họ tên</label>
        <input asp-for="FullName" />
    </div>

    <div>
        <label>Mã sinh viên</label>
        <input asp-for="StudentCode" />
    </div>

    <div>
        <label>Tuổi</label>
        <input asp-for="Age" />
    </div>

    <br />

    <button type="submit">Lưu</button>

</form>